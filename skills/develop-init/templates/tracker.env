# 90north-develop tracker settings — no secrets in this file (it may be committed).
# Backend: jira (the default when this line is missing) or local (a board of markdown cards in the repo, no Jira).
TRACKER=jira

# Jira: the site, and the credentials file with JIRA_EMAIL and JIRA_TOKEN (chmod 600, never committed, never printed).
JIRA_SITE=https://<site>.atlassian.net
JIRA_ENV_FILE=~/.config/<project>-jira.env

# Local board (TRACKER=local; delete the Jira lines above). Uncomment only to change a default.
# LOCAL_BOARD=board            # absolute, or relative to this folder
# LOCAL_STATUSES=todo,in-progress,need-info,review,ready-for-qa,reopened,done
